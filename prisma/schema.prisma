generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DEVELOPER
  CLIENT
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  PM
  DEVELOPER
  CLIENT
}

enum IssueStatus {
  OPEN
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityAction {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  COMMENTED
  ATTACHMENT_ADDED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  phone         String?
  password      String
  role          UserRole  @default(CLIENT)
  avatar        String?
  position      String?
  linkedin      String?
  github        String?
  inviteToken   String?   @unique
  inviteExpiry  DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdProjects  Project[]        @relation("ProjectCreator")
  memberships      ProjectMember[]
  createdIssues    Issue[]          @relation("IssueCreator")
  assignedIssues   Issue[]          @relation("IssueAssignee")
  issueAssignees   IssueAssignee[]
  projectUpdates   ProjectUpdate[]  @relation("UpdateAuthor")
  assignedUpdates  ProjectUpdate[]  @relation("UpdateAssignee")
  updateTimelineLogs ProjectUpdateLog[]
  comments         IssueComment[]
  activities       IssueActivity[]
  messages         ChatMessage[]
  notifications    Notification[]
  tickets          Ticket[]         @relation("TicketCreator")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  repository  String?
  techStack   String?
  status      ProjectStatus @default(ACTIVE)
  createdById String
  createdBy   User          @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members     ProjectMember[]
  issues      Issue[]
  updates     ProjectUpdate[]
  tickets     Ticket[]
  channel     ChatChannel?
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole
  joinedAt  DateTime          @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Issue {
  id           String        @id @default(cuid())
  projectId    String
  title        String
  description  String?       @db.Text
  status       IssueStatus   @default(OPEN)
  priority     IssuePriority @default(MEDIUM)
  createdById  String
  assignedToId String?
  attachments  Json          @default("[]")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User            @relation("IssueCreator", fields: [createdById], references: [id])
  assignedTo User?           @relation("IssueAssignee", fields: [assignedToId], references: [id])
  assignees  IssueAssignee[]
  projectUpdateId String?
  projectUpdate   ProjectUpdate? @relation(fields: [projectUpdateId], references: [id], onDelete: SetNull)
  comments   IssueComment[]
  activities IssueActivity[]
}

model IssueAssignee {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  createdAt DateTime @default(now())

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
}

model IssueComment {
  id          String   @id @default(cuid())
  issueId     String
  authorId    String
  content     String   @db.Text
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])
}

model IssueActivity {
  id        String         @id @default(cuid())
  issueId   String
  userId    String
  action    ActivityAction
  metadata  Json?
  createdAt DateTime       @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])
}

model ChatChannel {
  id        String   @id @default(cuid())
  projectId String   @unique
  name      String   @default("General")
  createdAt DateTime @default(now())

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
}

model ChatMessage {
  id          String   @id @default(cuid())
  channelId   String
  senderId    String
  content     String   @db.Text
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  User        @relation(fields: [senderId], references: [id])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  type          String
  title         String
  message       String   @db.Text
  referenceId   String?
  referenceType String?
  read          Boolean  @default(false)
  waSent        Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ProgressStatus {
  DO
  DOING
  DONE
}

enum TicketStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION
}

enum TicketType {
  DEPLOY
  FEATURE
  BUGFIX
  OTHER
}

model Ticket {
  id          String       @id @default(cuid())
  projectId   String
  createdById String
  title       String
  description String?      @db.Text
  type        TicketType   @default(OTHER)
  status      TicketStatus @default(PENDING)
  pmNotes     String?      @db.Text
  attachments Json         @default("[]")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TicketCreator", fields: [createdById], references: [id])
}

model ProjectUpdate {
  id           String         @id @default(cuid())
  projectId    String
  authorId     String
  assignedToId String?
  status       ProgressStatus @default(DOING)
  title        String
  content      String?        @db.Text
  notes        String?        @db.Text
  attachments  Json           @default("[]")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author       User           @relation("UpdateAuthor", fields: [authorId], references: [id])
  assignedTo   User?          @relation("UpdateAssignee", fields: [assignedToId], references: [id])
  issues       Issue[]
  timelineLogs ProjectUpdateLog[]
}

model ProjectUpdateLog {
  id              String        @id @default(cuid())
  projectUpdateId String
  authorId        String
  content         String        @db.Text
  notes           String?       @db.Text
  status          ProgressStatus?
  attachments     Json          @default("[]")
  createdAt       DateTime      @default(now())

  projectUpdate   ProjectUpdate @relation(fields: [projectUpdateId], references: [id], onDelete: Cascade)
  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

